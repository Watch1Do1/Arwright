# Copy this file to .env and fill in the values. Never commit .env or key files.

# --- Gemini (server only) ---
GEMINI_API_KEY=

# --- Firebase Admin credentials (server only) - use ONE of these ---
# Option A (your own computer): full path to the service account key file you downloaded
# from Firebase console -> Project settings -> Service accounts. Keep the file OUTSIDE
# this project folder.
GOOGLE_APPLICATION_CREDENTIALS=
# Option B (hosting dashboards / secrets): the whole key file contents on ONE line.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}

# --- Optional ---
# Normally read from firebase-applet-config.json; set only to override.
# FIREBASE_PROJECT_ID=
# FIREBASE_DATABASE_ID=
# Platform admin emails (comma-separated). Default: team@watch1do1.com,hello@arwrightlearning.com
# ADMIN_EMAILS=team@watch1do1.com,hello@arwrightlearning.com
# AI requests allowed per user per 10 minutes (default 30)
# AI_RATE_LIMIT_PER_10_MIN=30
# Show the offline "Demo / Guest Access" button on the login screen (build-time; default off)
# VITE_ENABLE_DEMO=true
